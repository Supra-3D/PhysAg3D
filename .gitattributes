# Preserve the delivered package bytes for package-manifest.json verification.
website/** -text

*.glb -text
*.obj -text
*.mp4 -text
*.png -text
*.webp -text
*.pdf -text
*.dll -text
*.pyd -text
*.exe -text
*.lib -text
*.zip -text
*.woff2 -text

# Small public showcase assets must be actual files in the Pages build.
/assets/** -filter -diff -merge -text
/viewer/** text=auto eol=lf
/viewer/vendor/ui-font.woff2 -filter -diff -merge -text
